@{
    ViewData["Title"] = "My Progress Tracking";
    var enrollments = ViewBag.Enrollments as List<GyanPath.Models.Enrollment> ?? new List<GyanPath.Models.Enrollment>();
    var quizAttempts = ViewBag.QuizAttempts as List<GyanPath.Models.QuizAttempt> ?? new List<GyanPath.Models.QuizAttempt>();
}

<div class="bg-primary text-white py-4 mb-4" style="background: linear-gradient(135deg, #0f172a, #1e3a8a);">
    <div class="container">
        <h1 class="font-heading text-white fw-bold display-6 mb-1"><i class="bi bi-graph-up-arrow me-2"></i> Learning Progress Overview</h1>
        <p class="opacity-90 mb-0">Track all your enrolled roadmaps, lesson completion percentages, and quiz attempt scores.</p>
    </div>
</div>

<div class="container pb-5">
    <!-- Enrolled Roadmaps Progress Cards -->
    <div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
        <h4 class="font-heading fw-bold mb-4 border-bottom pb-2">Roadmap Progress Tracking</h4>

        @if (enrollments.Count == 0)
        {
            <p class="text-muted">You are not currently enrolled in any learning roadmaps.</p>
        }
        else
        {
            <div class="row g-4">
                @foreach (var e in enrollments)
                {
                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 bg-white shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="domain-badge domain-@e.RoadmapDomain?.ToLower().Replace(" ", "")">@e.RoadmapDomain</span>
                                @if (e.IsCompleted)
                                {
                                    <span class="badge bg-success text-white"><i class="bi bi-check-all me-1"></i> Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary text-white">In Progress</span>
                                }
                            </div>
                            <h5 class="fw-bold mb-2">@e.RoadmapTitle</h5>
                            <div class="d-flex justify-content-between small text-muted mb-1 font-weight-bold">
                                <span>Completion</span>
                                <span>@e.ProgressPercentage%</span>
                            </div>
                            <div class="gp-progress-container mb-3">
                                <div class="gp-progress-bar" style="width: @e.ProgressPercentage%;"></div>
                            </div>
                            <a asp-controller="Roadmaps" asp-action="Details" asp-route-id="@e.RoadmapID" class="btn btn-outline-primary btn-sm w-100">
                                View Curriculum <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Full Quiz Attempt History -->
    <div class="card shadow-sm border-0 rounded-4 p-4">
        <h4 class="font-heading fw-bold mb-4 border-bottom pb-2">Quiz Attempt History</h4>

        @if (quizAttempts.Count == 0)
        {
            <p class="text-muted">No quiz attempt logs found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Roadmap</th>
                            <th>Lesson</th>
                            <th>Score</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in quizAttempts)
                        {
                            <tr>
                                <td>@q.RoadmapTitle</td>
                                <td class="fw-bold">@q.LessonTitle</td>
                                <td>@q.ScorePercentage% (@q.CorrectAnswers / @q.TotalQuestions)</td>
                                <td>
                                    @if (q.Passed)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i> Passed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-exclamation me-1"></i> Failed</span>
                                    }
                                </td>
                                <td class="small text-muted">@q.AttemptedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
