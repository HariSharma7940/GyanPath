@model GyanPath.Models.JobOpportunity
@{
    ViewData["Title"] = Model.Title + " at " + Model.Company;
    var domainClass = "domain-" + Model.Domain.ToLower().Replace(" ", "");
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="domain-badge @domainClass">@Model.Domain</span>
                    <span class="badge bg-secondary px-3 py-2">@Model.JobType</span>
                </div>

                <h1 class="font-heading fw-bold mb-2">@Model.Title</h1>
                <h4 class="text-primary fw-semibold mb-4"><i class="bi bi-building me-2"></i> @Model.Company</h4>

                <div class="d-flex flex-wrap gap-4 p-3 bg-light rounded-3 border mb-4 text-muted small">
                    <div><i class="bi bi-geo-alt-fill text-danger me-1"></i> <strong>Location:</strong> @Model.Location</div>
                    <div><i class="bi bi-calendar-event text-primary me-1"></i> <strong>Posted Date:</strong> @Model.PostedDate.ToString("MMM dd, yyyy")</div>
                </div>

                <h5 class="fw-bold mb-2 font-heading">Job Description</h5>
                <p class="text-muted leading-relaxed mb-4">@Model.Description</p>

                <h5 class="fw-bold mb-2 font-heading">Required Skills & Knowledge</h5>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    @foreach (var skill in Model.RequiredSkills.Split(','))
                    {
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fs-6 fw-normal">
                            <i class="bi bi-check-circle me-1"></i> @skill.Trim()
                        </span>
                    }
                </div>

                <div class="p-4 bg-light rounded-4 border text-center my-4">
                    <h5 class="fw-bold mb-2">Interested in applying for this position?</h5>
                    <p class="text-muted small mb-3">Click below to visit the official career application portal.</p>
                    <a href="@Model.ApplicationUrl" target="_blank" rel="noopener noreferrer" class="btn btn-gp-primary btn-lg font-weight-bold px-4">
                        <i class="bi bi-box-arrow-up-right me-2"></i> Apply on Official Career Site
                    </a>
                </div>

                <div class="pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to All Jobs
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
