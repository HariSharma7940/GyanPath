@model List<GyanPath.Models.JobOpportunity>
@{
    ViewData["Title"] = "Jobs & Internship Recommendations";
    string currentSearch = ViewBag.CurrentSearch as string ?? "";
    string currentDomain = ViewBag.CurrentDomain as string ?? "All";
    string currentJobType = ViewBag.CurrentJobType as string ?? "All";
}

<div class="bg-primary text-white py-4 mb-4" style="background: linear-gradient(135deg, #0f172a, #0d9488);">
    <div class="container">
        <h1 class="font-heading text-white fw-bold display-6 mb-1"><i class="bi bi-briefcase me-2"></i> Career & Internship Opportunities</h1>
        <p class="opacity-90 mb-0">Explore job and internship positions matched to your completed career roadmaps in Nepal.</p>
    </div>
</div>

<div class="container pb-5">
    <!-- Search & Filter Controls -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-4">
            <form asp-controller="Jobs" asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold small text-muted">Search Keywords</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="Search title, company, skills..." value="@currentSearch">
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted">Domain</label>
                    <select name="domain" class="form-select">
                        <option value="All" selected="@(currentDomain == "All")">All Domains</option>
                        <option value="Technology" selected="@(currentDomain == "Technology")">Technology</option>
                        <option value="Design" selected="@(currentDomain == "Design")">Design</option>
                        <option value="Business" selected="@(currentDomain == "Business")">Business</option>
                        <option value="Creative Arts" selected="@(currentDomain == "Creative Arts")">Creative Arts</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small text-muted">Job Type</label>
                    <select name="jobType" class="form-select">
                        <option value="All" selected="@(currentJobType == "All")">All Types</option>
                        <option value="Full-time" selected="@(currentJobType == "Full-time")">Full-time</option>
                        <option value="Internship" selected="@(currentJobType == "Internship")">Internship</option>
                        <option value="Part-time" selected="@(currentJobType == "Part-time")">Part-time</option>
                        <option value="Remote" selected="@(currentJobType == "Remote")">Remote</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-gp-primary w-100"><i class="bi bi-funnel me-1"></i> Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Job Cards -->
    @if (Model.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-4 border">
            <i class="bi bi-briefcase fs-1 text-muted mb-3 d-block"></i>
            <h4 class="fw-bold text-muted">No job opportunities found matching your criteria.</h4>
            <p class="text-muted small">Try broadening your search or resetting filters.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var job in Model)
            {
                var domainClass = "domain-" + job.Domain.ToLower().Replace(" ", "");
                <div class="col-md-6">
                    <div class="gp-card">
                        <div class="gp-card-body d-flex flex-column h-100">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="domain-badge @domainClass mb-2 d-inline-block">@job.Domain</span>
                                    @if (job.IsRecommended)
                                    {
                                        <span class="badge bg-warning text-dark ms-1 mb-2 d-inline-block"><i class="bi bi-star-fill me-1"></i> Recommended for You</span>
                                    }
                                    <h4 class="fw-bold mb-1 fs-5">@job.Title</h4>
                                    <h6 class="text-primary fw-semibold mb-2"><i class="bi bi-building me-1"></i> @job.Company</h6>
                                </div>
                                <span class="badge bg-light text-dark border px-3 py-2">@job.JobType</span>
                            </div>

                            <p class="text-muted small mb-3 line-clamp-2">@job.Description</p>

                            <!-- Required Skills badges -->
                            <div class="mb-3">
                                <span class="text-muted extra-small d-block mb-1">Required Skills:</span>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var skill in job.RequiredSkills.Split(','))
                                    {
                                        <span class="badge bg-light text-dark border extra-small">@skill.Trim()</span>
                                    }
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                                <span class="text-muted extra-small"><i class="bi bi-geo-alt me-1"></i> @job.Location</span>
                                <a asp-action="Details" asp-route-id="@job.JobID" class="btn btn-outline-primary btn-sm">
                                    View Details <i class="bi bi-chevron-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
