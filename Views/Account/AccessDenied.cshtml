@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 text-center">
            <div class="card shadow-sm border-0 rounded-4 p-5">
                <i class="bi bi-shield-lock-fill text-warning display-1 mb-3"></i>
                <h1 class="text-dark font-heading fw-bold">403 - Access Denied</h1>
                <p class="text-muted fs-5 mb-4">You do not have the required permissions to access this page. Administrator privileges are required.</p>
                <div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-gp-primary me-2">
                        <i class="bi bi-house-door me-1"></i> Return Home
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Switch Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
