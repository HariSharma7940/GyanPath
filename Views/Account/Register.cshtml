@model GyanPath.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Free Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <span class="brand-badge fs-4 p-2 d-inline-block rounded-3 mb-2 bg-primary text-white">
                            <i class="bi bi-mortarboard-fill"></i>
                        </span>
                        <h2 class="font-heading fw-bold">Create Your Account</h2>
                        <p class="text-muted small">Start your domain-based career learning roadmap today.</p>
                    </div>

                    <form asp-controller="Account" asp-action="Register" method="post" id="gyanpathRegisterForm">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                                <input asp-for="FullName" class="form-control" placeholder="e.g. Aarav Sharma" required />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="name@example.com" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                                    <input asp-for="Password" class="form-control" placeholder="Min 6 chars" id="regPassword" required />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-lock-fill"></i></span>
                                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter password" id="regConfirmPassword" required />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                <div id="passwordMatchError" class="text-danger small mt-1 d-none"></div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PreferredDomain" class="form-label fw-semibold"></label>
                            <select asp-for="PreferredDomain" class="form-select">
                                <option value="Technology">Technology (Software & Web Dev)</option>
                                <option value="Design">Design (UI/UX & Graphics)</option>
                                <option value="Business">Business (Digital Marketing & Analytics)</option>
                                <option value="Creative Arts">Creative Arts (Video & Content Creation)</option>
                            </select>
                            <span asp-validation-for="PreferredDomain" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Phone" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Phone" class="form-control" placeholder="+977-9800000000" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-gp-primary w-100 py-2 font-weight-bold fs-6">
                            <i class="bi bi-person-check me-1"></i> Register Free Account
                        </button>
                    </form>

                    <div class="text-center mt-4 pt-3 border-top">
                        <p class="text-muted small mb-0">Already have an account? <a asp-action="Login" class="text-primary fw-semibold">Log in here</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
