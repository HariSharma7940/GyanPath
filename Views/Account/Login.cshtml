@model GyanPath.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Account Login";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <!-- Demo Credentials Helper Alert -->
            <div class="card border-info bg-info-subtle mb-4 rounded-3 p-3">
                <div class="d-flex align-items-center gap-2 mb-2 text-info-emphasis fw-bold">
                    <i class="bi bi-key-fill fs-5"></i> Demo Login Credentials
                </div>
                <div class="small text-info-emphasis mb-1">
                    <strong>Admin Account:</strong> <code>admin@gyanpath.com</code> / <code>Admin@123</code>
                </div>
                <div class="small text-info-emphasis">
                    <strong>Member Account:</strong> <code>student@gyanpath.com</code> / <code>Student@123</code>
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <span class="brand-badge fs-4 p-2 d-inline-block rounded-3 mb-2 bg-primary text-white">
                            <i class="bi bi-mortarboard-fill"></i>
                        </span>
                        <h2 class="font-heading fw-bold">Welcome Back</h2>
                        <p class="text-muted small">Log in to access your roadmaps, progress & job recommendations.</p>
                    </div>

                    <form asp-controller="Account" asp-action="Login" method="post" id="gyanpathLoginForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="e.g. student@gyanpath.com" id="loginEmail" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" class="form-control" placeholder="Enter your password" id="loginPassword" required />
                                <button type="button" class="btn btn-outline-secondary toggle-password-btn" data-target="loginPassword">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label text-muted small"></label>
                        </div>

                        <button type="submit" class="btn btn-gp-primary w-100 py-2 font-weight-bold fs-6">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Log In
                        </button>
                    </form>

                    <div class="text-center mt-4 pt-3 border-top">
                        <p class="text-muted small mb-0">Don't have an account yet? <a asp-action="Register" class="text-primary fw-semibold">Register here</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
