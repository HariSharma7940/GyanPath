<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GyanPath Career Learning Platform</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- External Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (User.IsInRole("Admin"))
    {
        <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-gyanpath sticky-top">
            <div class="container">
                <a class="navbar-brand-gp text-decoration-none" asp-controller="Home" asp-action="Index">
                    <span class="brand-badge"><i class="bi bi-mortarboard-fill"></i></span>
                    GYANPATH
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#gyanpathNavbar" aria-controls="gyanpathNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="gyanpathNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link nav-link-gp" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-gp" asp-controller="Roadmaps" asp-action="Index"><i class="bi bi-compass me-1"></i> Roadmaps</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-gp" asp-controller="Jobs" asp-action="Index"><i class="bi bi-briefcase me-1"></i> Jobs & Internships</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-gp" asp-controller="Home" asp-action="About"><i class="bi bi-info-circle me-1"></i> About</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="btn btn-warning btn-sm font-weight-bold" asp-controller="AdminDashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-1"></i> Admin Panel
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-gp" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-grid-1x2 me-1"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link nav-link-gp" asp-controller="Progress" asp-action="Index">
                                        <i class="bi bi-graph-up-arrow me-1"></i> My Progress
                                    </a>
                                </li>
                            }

                            <li class="nav-item dropdown ms-lg-2">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 btn btn-light border px-3" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle text-primary fs-5"></i>
                                    <span class="fw-semibold text-dark">@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Profile" asp-action="Index">
                                            <i class="bi bi-person me-2 text-primary"></i> My Profile
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2 text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-gp-outline btn-sm me-1" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-gp-primary btn-sm" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Get Started
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Notification Messages -->
    <div class="container mt-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer-gyanpath">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <a class="navbar-brand-gp text-white text-decoration-none mb-3 d-inline-block" href="#">
                        <span class="brand-badge"><i class="bi bi-mortarboard-fill"></i></span> GYANPATH
                    </a>
                    <p class="text-secondary small">
                        GyanPath is a structured career learning and skill-building platform tailored for university students and fresh graduates in Nepal. Bridging the gap between academic theory and industry career opportunities.
                    </p>
                    <p class="text-secondary small mb-0">
                        <i class="bi bi-geo-alt me-1"></i> Kathmandu, Nepal
                    </p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h5>Learning Domains</h5>
                    <ul class="footer-links">
                        <li><a asp-controller="Roadmaps" asp-action="Index" asp-route-domain="Technology"><i class="bi bi-code-slash me-1"></i> Technology</a></li>
                        <li><a asp-controller="Roadmaps" asp-action="Index" asp-route-domain="Design"><i class="bi bi-palette me-1"></i> Design</a></li>
                        <li><a asp-controller="Roadmaps" asp-action="Index" asp-route-domain="Business"><i class="bi bi-graph-up me-1"></i> Business</a></li>
                        <li><a asp-controller="Roadmaps" asp-action="Index" asp-route-domain="Creative Arts"><i class="bi bi-camera-reels me-1"></i> Creative Arts</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5>Quick Links</h5>
                    <ul class="footer-links">
                        <li><a asp-controller="Roadmaps" asp-action="Index">Explore Roadmaps</a></li>
                        <li><a asp-controller="Jobs" asp-action="Index">Job Opportunities</a></li>
                        <li><a asp-controller="Home" asp-action="About">About Project</a></li>
                        <li><a asp-controller="Account" asp-action="Register">Create Free Account</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5>Academic Information</h5>
                    <p class="text-secondary small mb-1"><strong>Course:</strong> CT050-3-2-WAPP</p>
                    <p class="text-secondary small mb-1"><strong>Module:</strong> Web Applications</p>
                    <p class="text-secondary small mb-3"><strong>Technology:</strong> ASP.NET Core MVC & SQL Server (ADO.NET)</p>
                    <span class="badge bg-secondary">Academic Group Assignment</span>
                </div>
            </div>
            <hr class="border-secondary opacity-25 my-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-secondary">
                <p class="mb-0">&copy; @DateTime.Now.Year GyanPath Platform. All rights reserved.</p>
                <p class="mb-0">Designed & Developed with ASP.NET Core MVC & ADO.NET</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/validation.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
