@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="card shadow-sm border-0 rounded-4 p-5">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-1 mb-3"></i>
                <h1 class="text-danger font-heading">An Error Occurred</h1>
                <p class="text-muted fs-5 mb-4">An error occurred while processing your request. Please try again later.</p>

                @if (Model.ShowRequestId)
                {
                    <p class="small text-secondary mb-4">
                        <code>Request ID: @Model.RequestId</code>
                    </p>
                }

                <div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-gp-primary">
                        <i class="bi bi-house-door me-1"></i> Return to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
