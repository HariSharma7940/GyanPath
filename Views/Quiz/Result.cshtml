@model GyanPath.Models.ViewModels.QuizResultViewModel
@{
    ViewData["Title"] = "Quiz Result - " + Model.LessonTitle;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Score Card -->
            <div class="card shadow border-0 rounded-4 p-4 p-md-5 text-center mb-4 @(Model.Passed ? "bg-success-subtle border-success" : "bg-warning-subtle border-warning")">
                <div class="stat-icon mx-auto mb-3 @(Model.Passed ? "stat-icon-teal" : "stat-icon-amber") fs-1" style="width: 80px; height: 80px;">
                    @if (Model.Passed)
                    {
                        <i class="bi bi-award-fill text-success fs-1"></i>
                    }
                    else
                    {
                        <i class="bi bi-exclamation-triangle-fill text-warning fs-1"></i>
                    }
                </div>

                <h1 class="font-heading fw-bold mb-2">
                    @(Model.Passed ? "Quiz Passed!" : "Needs Improvement")
                </h1>
                <p class="text-muted fs-5 mb-4">
                    @(Model.Passed ? "Great job! You have demonstrated strong mastery of this lesson." : "You did not reach the 60% passing threshold. Review the answers below and try again.")
                </p>

                <div class="d-flex justify-content-center align-items-center gap-4 py-3 bg-white rounded-3 shadow-sm mx-auto max-w-500 mb-4">
                    <div>
                        <span class="text-muted small d-block">Score Percentage</span>
                        <strong class="fs-2 @(Model.Passed ? "text-success" : "text-danger")">@Model.ScorePercentage%</strong>
                    </div>
                    <div class="vr"></div>
                    <div>
                        <span class="text-muted small d-block">Correct Answers</span>
                        <strong class="fs-2 text-dark">@Model.CorrectAnswers / @Model.TotalQuestions</strong>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Quiz" asp-action="Start" asp-route-id="@Model.LessonID" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-clockwise me-1"></i> Retry Quiz
                    </a>
                    <a asp-controller="Lessons" asp-action="Details" asp-route-id="@Model.LessonID" class="btn btn-gp-primary">
                        <i class="bi bi-journal-text me-1"></i> Return to Lesson
                    </a>
                    <a asp-controller="Roadmaps" asp-action="Details" asp-route-id="@Model.RoadmapID" class="btn btn-gp-secondary">
                        <i class="bi bi-compass me-1"></i> Continue Roadmap
                    </a>
                </div>
            </div>

            <!-- Detailed Answer Review Section -->
            @if (Model.Reviews.Count > 0)
            {
                <div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
                    <h4 class="font-heading fw-bold mb-4 border-bottom pb-2">
                        <i class="bi bi-check2-square text-primary me-2"></i> Question Answer Review
                    </h4>

                    <div class="d-flex flex-column gap-4">
                        @{ int qIndex = 1; }
                        @foreach (var review in Model.Reviews)
                        {
                            <div class="p-3 rounded-3 border @(review.IsCorrect ? "bg-success-subtle border-success" : "bg-danger-subtle border-danger")">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <h6 class="fw-bold mb-0 text-dark">Q@qIndex. @review.QuestionText</h6>
                                    @if (review.IsCorrect)
                                    {
                                        <span class="badge bg-success text-white"><i class="bi bi-check-lg me-1"></i> Correct</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger text-white"><i class="bi bi-x-lg me-1"></i> Incorrect</span>
                                    }
                                </div>

                                <div class="small mb-2">
                                    <strong>Your Answer:</strong> <span class="@(review.IsCorrect ? "text-success fw-bold" : "text-danger fw-bold")">@review.SelectedOptionText</span>
                                </div>

                                @if (!review.IsCorrect)
                                {
                                    <div class="small mb-2 text-success">
                                        <strong>Correct Answer:</strong> <span class="fw-bold">@review.CorrectOptionText</span>
                                    </div>
                                }

                                <div class="p-2 bg-white rounded border extra-small text-muted mt-2">
                                    <i class="bi bi-info-circle text-info me-1"></i> <strong>Explanation:</strong> @review.Explanation
                                </div>
                            </div>
                            qIndex++;
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
