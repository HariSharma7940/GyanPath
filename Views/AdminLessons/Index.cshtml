@model List<GyanPath.Models.Lesson>
@{
    ViewData["Title"] = "Manage Lessons - Admin Panel";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-3 col-xl-2 mb-4 mb-lg-0">
            <partial name="_AdminSidebarPartial" />
        </div>

        <div class="col-lg-9 col-xl-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="font-heading fw-bold mb-1"><i class="bi bi-journal-bookmark-fill text-primary me-2"></i> Lesson Management</h2>
                    <p class="text-muted small mb-0">Manage lesson text content, video URLs, resources, and sequence orders in SQL Server.</p>
                </div>
                <a asp-action="Create" class="btn btn-gp-primary">
                    <i class="bi bi-plus-lg me-1"></i> Add New Lesson
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Roadmap</th>
                                    <th>Order</th>
                                    <th>Title</th>
                                    <th>Video Guide</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var lesson in Model)
                                {
                                    <tr>
                                        <td><code>#@lesson.LessonID</code></td>
                                        <td><span class="badge bg-info-subtle text-info-emphasis font-weight-bold">@lesson.RoadmapTitle</span></td>
                                        <td><span class="badge bg-secondary">#@lesson.LessonOrder</span></td>
                                        <td class="fw-semibold">@lesson.Title</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(lesson.VideoUrl))
                                            {
                                                <span class="badge bg-success-subtle text-success"><i class="bi bi-play-circle me-1"></i> Attached</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">None</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="Edit" asp-route-id="@lesson.LessonID" class="btn btn-sm btn-outline-primary me-1">
                                                <i class="bi bi-pencil me-1"></i> Edit
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@lesson.LessonID" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger confirm-delete-btn" data-item-name="@lesson.Title">
                                                    <i class="bi bi-trash me-1"></i> Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
