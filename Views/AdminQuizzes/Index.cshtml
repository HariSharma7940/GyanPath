@model List<GyanPath.Models.Question>
@{
    ViewData["Title"] = "Manage Quiz Questions - Admin Panel";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-3 col-xl-2 mb-4 mb-lg-0">
            <partial name="_AdminSidebarPartial" />
        </div>

        <div class="col-lg-9 col-xl-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="font-heading fw-bold mb-1"><i class="bi bi-patch-question-fill text-primary me-2"></i> Quiz Questions Management</h2>
                    <p class="text-muted small mb-0">Manage MCQ questions, multiple option choices, and correct answer flags via ADO.NET SQL operations.</p>
                </div>
                <a asp-action="Create" class="btn btn-gp-primary">
                    <i class="bi bi-plus-lg me-1"></i> Add Quiz Question
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Lesson</th>
                                    <th>Question Text</th>
                                    <th>Options Count</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var q in Model)
                                {
                                    <tr>
                                        <td><code>#@q.QuestionID</code></td>
                                        <td><span class="badge bg-info-subtle text-info-emphasis fw-semibold">@q.LessonTitle</span></td>
                                        <td class="fw-semibold text-dark">@q.QuestionText</td>
                                        <td><span class="badge bg-secondary">@q.Options.Count Options</span></td>
                                        <td class="text-end">
                                            <a asp-action="Edit" asp-route-id="@q.QuestionID" class="btn btn-sm btn-outline-primary me-1">
                                                <i class="bi bi-pencil me-1"></i> Edit
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@q.QuestionID" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger confirm-delete-btn" data-item-name="this question">
                                                    <i class="bi bi-trash me-1"></i> Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
