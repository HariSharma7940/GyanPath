@model GyanPath.Models.User
@{
    ViewData["Title"] = "User Profile - " + Model.FullName;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="stat-icon stat-icon-blue mx-auto mb-3 fs-1" style="width: 80px; height: 80px;">
                        <i class="bi bi-person-fill text-primary"></i>
                    </div>
                    <h2 class="font-heading fw-bold mb-1">@Model.FullName</h2>
                    <span class="badge bg-primary px-3 py-1">@Model.Role Account</span>
                </div>

                <div class="list-group list-group-flush mb-4">
                    <div class="list-group-item bg-transparent px-0 py-3 d-flex justify-content-between">
                        <span class="text-muted"><i class="bi bi-envelope me-2"></i> Email Address</span>
                        <strong class="text-dark">@Model.Email</strong>
                    </div>
                    <div class="list-group-item bg-transparent px-0 py-3 d-flex justify-content-between">
                        <span class="text-muted"><i class="bi bi-telephone me-2"></i> Phone Number</span>
                        <strong class="text-dark">@(string.IsNullOrEmpty(Model.Phone) ? "Not Provided" : Model.Phone)</strong>
                    </div>
                    <div class="list-group-item bg-transparent px-0 py-3 d-flex justify-content-between">
                        <span class="text-muted"><i class="bi bi-compass me-2"></i> Preferred Domain</span>
                        <span class="badge bg-info-subtle text-info-emphasis px-3 py-1 font-weight-bold">@Model.PreferredDomain</span>
                    </div>
                    <div class="list-group-item bg-transparent px-0 py-3 d-flex justify-content-between">
                        <span class="text-muted"><i class="bi bi-calendar-check me-2"></i> Member Since</span>
                        <strong class="text-dark">@Model.CreatedAt.ToString("MMM dd, yyyy")</strong>
                    </div>
                </div>

                <a asp-action="Edit" class="btn btn-gp-primary w-100">
                    <i class="bi bi-pencil-square me-1"></i> Edit Profile & Password
                </a>
            </div>
        </div>
    </div>
</div>
