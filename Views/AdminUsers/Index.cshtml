@model List<GyanPath.Models.User>
@{
    ViewData["Title"] = "Manage Users - Admin Panel";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-3 col-xl-2 mb-4 mb-lg-0">
            <partial name="_AdminSidebarPartial" />
        </div>

        <div class="col-lg-9 col-xl-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="font-heading fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i> User Management</h2>
                    <p class="text-muted small mb-0">View, add, edit, and deactivate user accounts using ADO.NET database operations.</p>
                </div>
                <a asp-action="Create" class="btn btn-gp-primary">
                    <i class="bi bi-person-plus-fill me-1"></i> Add New User
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Full Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Domain</th>
                                    <th>Created At</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model)
                                {
                                    <tr>
                                        <td><code>#@user.UserID</code></td>
                                        <td class="fw-semibold">@user.FullName</td>
                                        <td>@user.Email</td>
                                        <td>
                                            <span class="badge @(user.Role == "Admin" ? "bg-danger" : "bg-primary")">@user.Role</span>
                                        </td>
                                        <td><span class="badge bg-secondary">@user.PreferredDomain</span></td>
                                        <td class="small text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                        <td class="text-end">
                                            <a asp-action="Edit" asp-route-id="@user.UserID" class="btn btn-sm btn-outline-primary me-1">
                                                <i class="bi bi-pencil me-1"></i> Edit
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@user.UserID" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger confirm-delete-btn" data-item-name="@user.FullName">
                                                    <i class="bi bi-trash me-1"></i> Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
