@model GyanPath.Models.User
@{
    ViewData["Title"] = "Edit User - Admin";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-3 col-xl-2 mb-4 mb-lg-0">
            <partial name="_AdminSidebarPartial" />
        </div>

        <div class="col-lg-9 col-xl-10">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 max-w-700">
                <h2 class="font-heading fw-bold mb-4"><i class="bi bi-pencil-square text-primary me-2"></i> Edit User Account #@Model.UserID</h2>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserID" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label fw-semibold"></label>
                            <select asp-for="Role" class="form-select">
                                <option value="Member">Member (Learner)</option>
                                <option value="Admin">Administrator</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PreferredDomain" class="form-label fw-semibold"></label>
                            <select asp-for="PreferredDomain" class="form-select">
                                <option value="Technology">Technology</option>
                                <option value="Design">Design</option>
                                <option value="Business">Business</option>
                                <option value="Creative Arts">Creative Arts</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label fw-semibold"></label>
                        <input asp-for="Phone" class="form-control" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary">Reset Password (Optional)</label>
                        <input type="password" name="newPassword" class="form-control" placeholder="Leave blank to keep existing password" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-gp-primary"><i class="bi bi-save me-1"></i> Update User</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
