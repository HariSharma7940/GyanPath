@model GyanPath.Models.JobOpportunity
@{
    ViewData["Title"] = "Edit Job Opportunity - Admin";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-3 col-xl-2 mb-4 mb-lg-0">
            <partial name="_AdminSidebarPartial" />
        </div>

        <div class="col-lg-9 col-xl-10">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 max-w-700">
                <h2 class="font-heading fw-bold mb-4"><i class="bi bi-pencil-square text-primary me-2"></i> Edit Job Opportunity #@Model.JobID</h2>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="JobID" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Company" class="form-label fw-semibold"></label>
                        <input asp-for="Company" class="form-control" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Domain" class="form-label fw-semibold"></label>
                            <select asp-for="Domain" class="form-select">
                                <option value="Technology">Technology</option>
                                <option value="Design">Design</option>
                                <option value="Business">Business</option>
                                <option value="Creative Arts">Creative Arts</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="JobType" class="form-label fw-semibold"></label>
                            <select asp-for="JobType" class="form-select">
                                <option value="Full-time">Full-time</option>
                                <option value="Internship">Internship</option>
                                <option value="Part-time">Part-time</option>
                                <option value="Remote">Remote</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Location" class="form-label fw-semibold"></label>
                        <input asp-for="Location" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="RequiredSkills" class="form-label fw-semibold">Required Skills</label>
                        <input asp-for="RequiredSkills" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="ApplicationUrl" class="form-label fw-semibold">Application Link</label>
                        <input asp-for="ApplicationUrl" class="form-control" required />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-gp-primary"><i class="bi bi-check-lg me-1"></i> Update Opportunity</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
