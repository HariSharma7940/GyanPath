@model List<GyanPath.Models.Roadmap>
@{
    ViewData["Title"] = "Manage Roadmaps - Admin Panel";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-3 col-xl-2 mb-4 mb-lg-0">
            <partial name="_AdminSidebarPartial" />
        </div>

        <div class="col-lg-9 col-xl-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="font-heading fw-bold mb-1"><i class="bi bi-compass-fill text-primary me-2"></i> Roadmap Management</h2>
                    <p class="text-muted small mb-0">Create, view, update, and remove career learning roadmaps in SQL Server.</p>
                </div>
                <a asp-action="Create" class="btn btn-gp-primary">
                    <i class="bi bi-plus-lg me-1"></i> Create Roadmap
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Title</th>
                                    <th>Domain</th>
                                    <th>Difficulty</th>
                                    <th>Duration</th>
                                    <th>Lessons</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rm in Model)
                                {
                                    <tr>
                                        <td><code>#@rm.RoadmapID</code></td>
                                        <td class="fw-semibold">@rm.Title</td>
                                        <td><span class="domain-badge domain-@rm.Domain.ToLower().Replace(" ", "")">@rm.Domain</span></td>
                                        <td><span class="badge bg-light text-dark border">@rm.Difficulty</span></td>
                                        <td class="small text-muted">@rm.EstimatedDuration</td>
                                        <td><span class="badge bg-primary text-white font-weight-bold">@rm.LessonCount Lessons</span></td>
                                        <td class="text-end">
                                            <a asp-action="Edit" asp-route-id="@rm.RoadmapID" class="btn btn-sm btn-outline-primary me-1">
                                                <i class="bi bi-pencil me-1"></i> Edit
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@rm.RoadmapID" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger confirm-delete-btn" data-item-name="@rm.Title">
                                                    <i class="bi bi-trash me-1"></i> Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
