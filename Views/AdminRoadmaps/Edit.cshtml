@model GyanPath.Models.Roadmap
@{
    ViewData["Title"] = "Edit Roadmap - Admin";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-3 col-xl-2 mb-4 mb-lg-0">
            <partial name="_AdminSidebarPartial" />
        </div>

        <div class="col-lg-9 col-xl-10">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 max-w-700">
                <h2 class="font-heading fw-bold mb-4"><i class="bi bi-pencil-square text-primary me-2"></i> Edit Roadmap #@Model.RoadmapID</h2>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RoadmapID" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Domain" class="form-label fw-semibold"></label>
                            <select asp-for="Domain" class="form-select">
                                <option value="Technology">Technology</option>
                                <option value="Design">Design</option>
                                <option value="Business">Business</option>
                                <option value="Creative Arts">Creative Arts</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Difficulty" class="form-label fw-semibold"></label>
                            <select asp-for="Difficulty" class="form-select">
                                <option value="Beginner">Beginner</option>
                                <option value="Intermediate">Intermediate</option>
                                <option value="Advanced">Advanced</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EstimatedDuration" class="form-label fw-semibold"></label>
                        <input asp-for="EstimatedDuration" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
                    </div>

                    <div class="mb-4">
                        <label asp-for="LearningObjectives" class="form-label fw-semibold"></label>
                        <textarea asp-for="LearningObjectives" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-gp-primary"><i class="bi bi-check-lg me-1"></i> Update Roadmap</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
