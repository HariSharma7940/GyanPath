@model GyanPath.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Learner Dashboard - " + Model.User.FullName;
}

<div class="bg-primary text-white py-4 mb-4" style="background: linear-gradient(135deg, #0f172a, #1e3a8a);">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-info-subtle text-info-emphasis px-3 py-1 rounded-pill mb-2"><i class="bi bi-person-workspace me-1"></i> Member Dashboard</span>
                <h1 class="font-heading text-white fw-bold display-6 mb-1">Welcome back, @Model.User.FullName!</h1>
                <p class="opacity-90 mb-0">Preferred Domain: <strong class="text-warning">@Model.User.PreferredDomain</strong></p>
            </div>
            <a asp-controller="Roadmaps" asp-action="Index" class="btn btn-gp-secondary d-none d-md-inline-block">
                <i class="bi bi-compass me-1"></i> Browse More Roadmaps
            </a>
        </div>
    </div>
</div>

<div class="container pb-5">
    <!-- Stat Cards Overview -->
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-blue">
                    <i class="bi bi-compass-fill"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Enrolled Roadmaps</span>
                    <h3 class="fw-bold mb-0">@Model.TotalEnrolled</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-teal">
                    <i class="bi bi-journal-check"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Completed Lessons</span>
                    <h3 class="fw-bold mb-0">@Model.TotalCompletedLessons</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-purple">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Completed Roadmaps</span>
                    <h3 class="fw-bold mb-0">@Model.TotalCompletedRoadmaps</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-amber">
                    <i class="bi bi-award-fill"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Passed Quizzes</span>
                    <h3 class="fw-bold mb-0">@Model.TotalQuizzesPassed</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Active Enrolled Roadmaps Section -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="font-heading fw-bold mb-0"><i class="bi bi-journal-bookmark-fill text-primary me-2"></i> My Active Roadmaps</h4>
                    <a asp-controller="Roadmaps" asp-action="Index" class="btn btn-outline-primary btn-sm">Explore All</a>
                </div>

                @if (Model.ActiveEnrollments.Count == 0)
                {
                    <div class="text-center py-4 bg-light rounded-3 border">
                        <i class="bi bi-journal-plus fs-2 text-muted mb-2 d-block"></i>
                        <p class="text-muted mb-2">You haven't enrolled in any active roadmaps yet.</p>
                        <a asp-controller="Roadmaps" asp-action="Index" class="btn btn-gp-primary btn-sm">Browse Roadmaps to Enroll</a>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var enrollment in Model.ActiveEnrollments)
                        {
                            <div class="p-3 border rounded-3 bg-white hover-shadow transition-all">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <span class="domain-badge domain-@enrollment.RoadmapDomain?.ToLower().Replace(" ", "") mb-1 d-inline-block">@enrollment.RoadmapDomain</span>
                                        <h5 class="fw-bold mb-0">
                                            <a asp-controller="Roadmaps" asp-action="Details" asp-route-id="@enrollment.RoadmapID" class="text-decoration-none text-dark">
                                                @enrollment.RoadmapTitle
                                            </a>
                                        </h5>
                                    </div>
                                    <a asp-controller="Roadmaps" asp-action="Details" asp-route-id="@enrollment.RoadmapID" class="btn btn-gp-primary btn-sm">
                                        Continue Learning <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>

                                <div class="mt-3">
                                    <div class="d-flex justify-content-between small text-muted mb-1 font-weight-bold">
                                        <span>Progress</span>
                                        <span>@enrollment.ProgressPercentage%</span>
                                    </div>
                                    <div class="gp-progress-container">
                                        <div class="gp-progress-bar" style="width: @enrollment.ProgressPercentage%;"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Recent Quiz Attempts Table -->
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <h4 class="font-heading fw-bold mb-3"><i class="bi bi-clock-history text-primary me-2"></i> Recent Quiz Attempts</h4>

                @if (Model.RecentQuizAttempts.Count == 0)
                {
                    <p class="text-muted small mb-0">No quiz attempts recorded yet. Open a lesson to take its quiz assessment.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-uppercase">
                                <tr>
                                    <th>Lesson</th>
                                    <th>Score</th>
                                    <th>Status</th>
                                    <th>Attempt Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var qa in Model.RecentQuizAttempts)
                                {
                                    <tr>
                                        <td class="fw-semibold">@qa.LessonTitle</td>
                                        <td class="fw-bold">@qa.ScorePercentage% (@qa.CorrectAnswers/@qa.TotalQuestions)</td>
                                        <td>
                                            @if (qa.Passed)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i> Passed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1"><i class="bi bi-x-circle-fill me-1"></i> Failed</span>
                                            }
                                        </td>
                                        <td class="small text-muted">@qa.AttemptedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar: Recommended Job Opportunities -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="font-heading fw-bold mb-0"><i class="bi bi-briefcase-fill text-success me-2"></i> Job Recommendations</h5>
                    <a asp-controller="Jobs" asp-action="Index" class="small text-decoration-none">View All</a>
                </div>
                <p class="small text-muted mb-3">Rule-based job/internship recommendations matching your learning progress & domain.</p>

                <div class="d-flex flex-column gap-3">
                    @foreach (var job in Model.RecommendedJobs)
                    {
                        <div class="p-3 border rounded-3 bg-light position-relative">
                            @if (job.IsRecommended)
                            {
                                <span class="badge bg-warning text-dark extra-small mb-2 d-inline-block">
                                    <i class="bi bi-star-fill me-1"></i> Recommended
                                </span>
                            }
                            <h6 class="fw-bold mb-1">
                                <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.JobID" class="text-decoration-none text-dark">@job.Title</a>
                            </h6>
                            <p class="small text-muted mb-1"><i class="bi bi-building me-1"></i> @job.Company</p>
                            <div class="d-flex justify-content-between align-items-center text-muted extra-small">
                                <span><i class="bi bi-geo-alt me-1"></i> @job.Location</span>
                                <span class="badge bg-secondary">@job.JobType</span>
                            </div>
                            @if (!string.IsNullOrEmpty(job.RecommendationReason))
                            {
                                <div class="mt-2 pt-2 border-top extra-small text-info-emphasis">
                                    <i class="bi bi-info-circle me-1"></i> @job.RecommendationReason
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
